{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static files from dist/, plus worker/index.js for the one thing that needs
  // code: a pass-through for the Copernicus elevation tiles the Landscape page
  // reads (they send no CORS headers). A request that matches a file is served
  // as that file without running the Worker.
  //
  // Cloudflare Workers Builds deploys every push to main by running
  // `npx wrangler deploy`, which runs the build below first, so the site
  // always matches the source in this repo.
  //
  // IMPORTANT: in the Cloudflare dashboard, Workers Builds > Settings, the
  // "Deploy command" must be:   npx wrangler deploy
  // (NOT `wrangler versions upload` — that uploads a version but never
  //  promotes it to production, so the live site never changes.)
  "name": "audio-terrain",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
