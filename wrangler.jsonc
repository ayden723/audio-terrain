{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spectral-relief",
  "compatibility_date": "2026-09-11",
  // Static-assets-only Worker: there is no server code, so no `main` entry.
  // Without this file `wrangler deploy` runs its setup wizard and tries to
  // rewrite vite.config.js, which fails in CI.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
