{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "audio-terrain",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5184,
      "autoPort": false
    },
    {
      "name": "audio-terrain-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "audio-terrain-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8790"
      ],
      "port": 8790
    }
  ]
}
